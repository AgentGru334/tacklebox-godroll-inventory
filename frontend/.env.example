# Optional. Leave empty when the frontend and API share one origin (dev Vite proxy, or a reverse proxy).
# For a split-origin deploy (e.g. Sites frontend + Railway API), set the public API origin with no trailing slash.
# This value is baked in at build time.
# VITE_BACKEND_URL=https://your-api.up.railway.app
VITE_BACKEND_URL=
