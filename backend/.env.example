# Copy to backend/.env and fill in. Never commit real values.
MONGO_URL=mongodb://localhost:27017
DB_NAME=tacklebox_card_injector
# Comma-separated browser origins allowed to call the API (required if the frontend is on a different origin)
CORS_ORIGINS=https://godroll.the-tacklebox.fish
# Public base URL of the app (documented; not currently read by backend code)
APP_URL=https://godroll.the-tacklebox.fish
# Optional timezone for "today" calculations (default UTC)
# APP_TZ=America/Chicago
# Clerk (https://dashboard.clerk.com -> API keys). pk_test_/sk_test_ for development, pk_live_/sk_live_ for production.
# Create a new Clerk application; the Emergent-managed instance does not transfer.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Google account email that becomes admin on first sign-in; everyone else starts as reviewer
ADMIN_EMAIL=
